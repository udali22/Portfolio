# ========================================================
# Portfolio Environment Configuration Template
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ========================================================

# Host Port Mappings
# Port exposed on your local machine / host for the Frontend UI
FRONTEND_PORT=3000

# Port exposed on your local machine / host for the FastAPI Backend
BACKEND_PORT=8000

# Application Environment Mode (development | production)
ENVIRONMENT=development

# Application Display Name
APP_NAME="Mohamed Ali Maali | Portfolio API"

# Allowed CORS Origins (comma-separated list for backend validation)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80,http://localhost

# ========================================================
# SECURITY NOTICE:
# Never put real passwords, private keys, or API tokens in this file.
# In production, inject secrets securely via host environment variables
# or your cloud deployment secrets manager (e.g., Azure Key Vault / GitHub Secrets).
# ========================================================
